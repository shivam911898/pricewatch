# Everything here is optional. The demo (DEMO_MODE=1) needs no keys at all.

# --- mode & schedule ---
DEMO_MODE=0                    # 1 = embedded fake competitor shop + checks every 60 s (public demo)
CHECK_INTERVAL_SECONDS=3600    # real mode default: hourly (be polite: do not go much lower)
SCHEDULER=1                    # 0 = no built-in scheduler, use cron + `python monitor.py --once`
DASHBOARD_PASSWORD=            # set this before exposing the dashboard (HTTP Basic, user: admin)

# --- storage (point these at a persistent volume in production) ---
# PM_DB=/data/prices.db
# PM_CONFIG=/data/products.yaml

# --- alert channels ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=   # path to the service-account JSON; share the sheet with that account
SHEET_ID=

# --- AI (weekly report summary + backend: browser_agent) ---
# Groq is the default provider (free tier, OpenAI-compatible). Gemini is optional. No key = templated summary.
LLM_PROVIDER=                  # groq | gemini | none. Blank = groq if GROQ_API_KEY is set, else gemini if GEMINI_API_KEY is set, else none
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b                  # weekly-report summary (openai/gpt-oss-20b = faster / cheaper)
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b          # used automatically when the primary model's daily cap is hit (empty = off)
# GROQ_BROWSER_MODEL=openai/gpt-oss-120b          # browser_agent on Groq is text/DOM-only (no vision); screenshots need Gemini
# GROQ_BASE_URL=https://api.groq.com/openai/v1    # only to point at a mock / proxy
# (confirm current model ids with: GET https://api.groq.com/openai/v1/models, or run `python smoke_groq.py --models`)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite

# --- scraper identity ---
# The User-Agent (with a contact address sites can write to) is set in products.yaml -> settings.user_agent:
#   PriceWatch/1.0 (+https://github.com/shivam911898/pricewatch; contact: sak23571113@gmail.com)
# Client deployments should put the client's own contact there.

# --- advanced ---
# ALLOW_PRIVATE_URLS=1         # let the "Add product" form accept intranet/localhost URLs (staging only)
# MAX_PRODUCTS=500
# DEMO_ALLOW_EXTERNAL=1        # let a DEMO_MODE instance accept real external URLs (not recommended on a public demo)
